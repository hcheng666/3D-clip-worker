# Use an immutable production tag from your registry when deploying with docker compose pull.
COMPOSE_PROJECT_NAME=three-d-tiles-clip-worker
CLIP_WORKER_IMAGE=3d-tiles-clip-worker:0.1.3

# Required. This address must be reachable from inside the Worker container.
CLIP_WORKER_CONTROL_PLANE_URL=http://server-metadata:8080

# Leave blank to use Docker's unique container HOSTNAME, especially when scaling replicas.
CLIP_WORKER_ID=
# Optional complete header, for example: Authorization: Bearer <token>
CLIP_WORKER_AUTHORIZATION_HEADER=
CLIP_WORKER_ALGORITHM_VERSION=v4

CLIP_WORKER_MAX_INPUT_BYTES=67108864
CLIP_WORKER_MAX_OUTPUT_BYTES=67108864
CLIP_WORKER_POLL_INTERVAL_SECONDS=5
CLIP_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
CLIP_WORKER_API_CONNECT_TIMEOUT_SECONDS=10
CLIP_WORKER_API_REQUEST_TIMEOUT_SECONDS=30
CLIP_WORKER_TRANSFER_CONNECT_TIMEOUT_SECONDS=10
CLIP_WORKER_TRANSFER_REQUEST_TIMEOUT_SECONDS=300
# DEBUG includes empty polls and successful heartbeats; production defaults to INFO.
CLIP_WORKER_LOG_LEVEL=INFO

CLIP_WORKER_STOP_GRACE_PERIOD=10m
CLIP_WORKER_LOG_MAX_SIZE=10m
CLIP_WORKER_LOG_MAX_FILES=5

# Build settings. Keep the official defaults or point them at approved internal mirrors.
# prepare-bundle.sh --mirror-profile cn supplies domestic defaults for these download endpoints;
# explicit environment values still take precedence over that profile.
CLIP_WORKER_BASE_IMAGE=ubuntu:24.04
# Used by Dockerfile.base. Leave empty for official Ubuntu sources.
CLIP_WORKER_APT_MIRROR=
CLIP_WORKER_VCPKG_REF=2025.07.25
CLIP_WORKER_VCPKG_REPOSITORY=https://github.com/microsoft/vcpkg.git
CLIP_WORKER_VCPKG_ASSET_PREFIX=https://github.com
CLIP_WORKER_VCPKG_GITHUB_ASSET_PREFIX=
CLIP_WORKER_VCPKG_SQLITE_MIRROR_PREFIX=

# Offline native build settings. Change both tag suffixes to arm64 on an ARM64 Linux host.
CLIP_WORKER_DEPS_VERSION=ubuntu24.04-vcpkg2025.07.25-r1
CLIP_WORKER_BUILD_BASE_IMAGE=3d-tiles-clip-worker-build-base:ubuntu24.04-vcpkg2025.07.25-r1-amd64
CLIP_WORKER_RUNTIME_BASE_IMAGE=3d-tiles-clip-worker-runtime-base:ubuntu24.04-vcpkg2025.07.25-r1-amd64
